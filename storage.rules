rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function admin() { return request.auth != null && (request.auth.token.admin == true || request.auth.token.role == 'admin'); }
    function safeImage() { return request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)'); }
    match /public/{allPaths=**} { allow read: if true; allow write: if admin() && safeImage(); }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
